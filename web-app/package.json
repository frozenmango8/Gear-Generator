{
  "name": "lego-gear-web",
  "version": "1.0.0",
  "description": "Browser-based LEGO Technic gear generator (TypeScript port of the Python tool)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:artifact": "vite build --config vite.artifact.config.ts && node make-artifact-content.mjs",
    "test": "tsx test/watertight.test.ts"
  },
  "dependencies": {
    "manifold-3d": "^3.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
